{
  "manifest_version": 3,
  "name": "Send to dotSharK",
  "version": "0.1.3",
  "description": "Send a video page or clicked video link to dotSharK for silent download.",
  "permissions": [
    "contextMenus",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "pairing.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
